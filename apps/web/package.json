{
  "name": "@tideline/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cli": "bun build ../cli/src/index.ts --target=node --minify --outfile=public/cli/tideline.mjs",
    "dev": "bun run build:cli && next dev --hostname localhost",
    "build": "bun run build:cli && next build",
    "start": "next start",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.0",
    "@tideline/contracts": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5"
  }
}
