{
  "name": "@tideline/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "start": "bun dist/index.js",
    "check-types": "tsc --noEmit",
    "db:migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.29.0",
    "@clerk/shared": "4.45.1",
    "@tideline/contracts": "workspace:*",
    "hono": "4.13.18",
    "@tideline/db": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  }
}
